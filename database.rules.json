{
  "rules": {
    "notes": {
      "$cle": {
        "$onglet": {
          ".read": "$cle.length >= 22 && ($onglet == '1' || $onglet == '2' || $onglet == '3' || $onglet == 'n1' || $onglet == 'n2' || $onglet == 'n3' || $onglet == 'i1' || $onglet == 'i2' || $onglet == 'i3' || $onglet == 't1' || $onglet == 't2' || $onglet == 't3' || $onglet == 'tn1' || $onglet == 'tn2' || $onglet == 'tn3' || $onglet == 'ti1' || $onglet == 'ti2' || $onglet == 'ti3')",
          ".write": "$cle.length >= 22 && ($onglet == '1' || $onglet == '2' || $onglet == '3' || $onglet == 'n1' || $onglet == 'n2' || $onglet == 'n3' || $onglet == 'i1' || $onglet == 'i2' || $onglet == 'i3' || $onglet == 't1' || $onglet == 't2' || $onglet == 't3' || $onglet == 'tn1' || $onglet == 'tn2' || $onglet == 'tn3' || $onglet == 'ti1' || $onglet == 'ti2' || $onglet == 'ti3')",
          ".validate": "newData.isString() && newData.val().length <= ($onglet.contains('n') ? 20 : ($onglet.contains('i') ? 300000 : 1000000))"
        }
      }
    },
    "images": {
      "$cle": {
        "$id": {
          ".read": "$cle.length >= 22 && $id.length <= 40",
          ".write": "$cle.length >= 22 && $id.length <= 40",
          ".validate": "newData.hasChildren()",
          "$morceau": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          }
        }
      }
    }
  }
}
