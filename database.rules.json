{
  "rules": {
    "notes": {
      "$cle": {
        ".write": "$cle.length >= 22 && !newData.exists()",
        "$onglet": {
          ".read": "$cle.length >= 22 && ($onglet == '1' || $onglet == '2' || $onglet == '3' || $onglet == '4' || $onglet == '5' || $onglet == 'n1' || $onglet == 'n2' || $onglet == 'n3' || $onglet == 'n4' || $onglet == 'n5' || $onglet == 'i1' || $onglet == 'i2' || $onglet == 'i3' || $onglet == 'i4' || $onglet == 'i5' || $onglet == 't1' || $onglet == 't2' || $onglet == 't3' || $onglet == 't4' || $onglet == 't5' || $onglet == 'tn1' || $onglet == 'tn2' || $onglet == 'tn3' || $onglet == 'tn4' || $onglet == 'tn5' || $onglet == 'ti1' || $onglet == 'ti2' || $onglet == 'ti3' || $onglet == 'ti4' || $onglet == 'ti5')",
          ".write": "$cle.length >= 22 && ($onglet == '1' || $onglet == '2' || $onglet == '3' || $onglet == '4' || $onglet == '5' || $onglet == 'n1' || $onglet == 'n2' || $onglet == 'n3' || $onglet == 'n4' || $onglet == 'n5' || $onglet == 'i1' || $onglet == 'i2' || $onglet == 'i3' || $onglet == 'i4' || $onglet == 'i5' || $onglet == 't1' || $onglet == 't2' || $onglet == 't3' || $onglet == 't4' || $onglet == 't5' || $onglet == 'tn1' || $onglet == 'tn2' || $onglet == 'tn3' || $onglet == 'tn4' || $onglet == 'tn5' || $onglet == 'ti1' || $onglet == 'ti2' || $onglet == 'ti3' || $onglet == 'ti4' || $onglet == 'ti5')",
          ".validate": "newData.isString() && newData.val().length <= ($onglet.contains('n') ? 20 : ($onglet.contains('i') ? 300000 : 1000000))"
        }
      }
    },
    "images": {
      "$cle": {
        ".write": "$cle.length >= 22 && !newData.exists()",
        "$id": {
          ".read": "$cle.length >= 22 && $id.length <= 40",
          ".write": "$cle.length >= 22 && $id.length <= 40",
          ".validate": "newData.hasChildren()",
          "$morceau": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          }
        }
      }
    }
  }
}
